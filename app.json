{
  "expo": {
    "name": "Travonal",
    "slug": "travonal",
    "owner": "travonal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travonal",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.michaelkonshin.travonal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAZxyMdXz-qnm-Kgm-_0ned5uSqDdbnMkU"
        }
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-iap",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Travonal uses your location to show places near you in Explore."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyAZxyMdXz-qnm-Kgm-_0ned5uSqDdbnMkU",
      "router": {},
      "eas": {
        "projectId": "bdb9ce43-7fcb-4ede-a7e3-e591c2ef72ee"
      }
    }
  }
}
