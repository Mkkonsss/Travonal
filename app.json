{
  "expo": {
    "name": "Tripseek",
    "slug": "travonal",
    "owner": "travonal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripseek",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tripseek.app",
      "deploymentTarget": "16.4",
      "associatedDomains": [
        "applinks:tripseekapp.com"
      ],
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Tripseek uses your location to show nearby places and personalise your trip recommendations.",
        "NSPhotoLibraryUsageDescription": "Tripseek needs access to your photo library to import screenshots of places you want to visit.",
        "NSCameraUsageDescription": "Tripseek uses the camera to capture screenshots of places you want to add to your trips."
      }
    },
    "android": {
      "package": "com.tripseek.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_KEY_PLACEHOLDER"
        }
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tripseekapp.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo-light.png",
          "imageWidth": 180
        }
      ],
      "expo-iap",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tripseek uses your location to show places near you in Explore."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdb9ce43-7fcb-4ede-a7e3-e591c2ef72ee"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bdb9ce43-7fcb-4ede-a7e3-e591c2ef72ee"
    }
  }
}
